---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getDb, type Product } from '../lib/db';

// Fetch featured products
const db = getDb();
let featuredProducts: Product[] = [];
try {
  featuredProducts = db.prepare('SELECT * FROM products WHERE featured = 1 LIMIT 4').all() as Product[];
} catch (e) {
  console.error(e);
}
---

  <BaseLayout title="Beranda">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container">
      <div class="hero-content animate-fade-in">
        <span class="badge">Koleksi Terbaru</span>
        <h1 class="title">Temukan Aroma Khas Anda di Balik Awan</h1>
        <p class="subtitle">Rasakan wewangian yang ringan, segar, dan modern yang dirancang untuk mengangkat momen sehari-hari Anda.</p>
        <div class="hero-actions">
          <a href="/shop" class="btn btn-primary">Belanja Sekarang</a>
          <a href="/about" class="btn btn-secondary glass">Kisah Kami</a>
        </div>
      </div>
      <div class="hero-image glass-card animate-fade-in delay-200">
        <img src="https://images.unsplash.com/photo-1588405748880-12d1d2a59f75?auto=format&fit=crop&q=80&w=1200" alt="Botol Parfum Santara" />
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section class="featured section">
    <div class="container">
      <div class="section-header text-center animate-fade-in delay-100">
        <h2 class="section-title">Aroma Pilihan</h2>
        <p class="section-subtitle">Wewangian yang paling disukai, dipilih khusus untuk Anda.</p>
      </div>
      
      <div class="product-grid">
        {featuredProducts.map((product, index) => (
          <div class={`animate-fade-in delay-${(index % 3 + 1) * 100}`}>
            <ProductCard product={product} />
          </div>
        ))}
        {featuredProducts.length === 0 && (
          <p class="empty-state">Belum ada produk pilihan. Silakan masukkan data ke database (seed).</p>
        )}
      </div>
      
      <div class="text-center mt-4">
        <a href="/shop" class="btn btn-secondary glass">Lihat Semua Produk</a>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="about section glass">
    <div class="container about-container">
      <div class="about-image glass-card animate-fade-in delay-100">
        <img src="https://images.unsplash.com/photo-1608528577891-eb055944f2e7?auto=format&fit=crop&q=80&w=800" alt="Bahan Parfum" />
      </div>
      <div class="about-content animate-fade-in delay-200">
        <h2 class="section-title">Esensi Santara</h2>
        <p class="mb-4">Didirikan dengan prinsip bahwa kemewahan harus terasa seringan udara, Santara membawa perspektif segar ke dalam pembuatan parfum modern.</p>
        <p class="mb-4">Kami mencari bahan-bahan terbaik secara global untuk meracik wewangian yang bukan hanya dipakai, melainkan dirasakan. Pendekatan terinspirasi awan kami mengartikan tidak ada aroma yang berat dan menyengat—hanya wewangian murni, bersih, dan tak terlupakan.</p>
        <ul class="features-list">
          <li>🌿 Bahan Baku Berkelanjutan</li>
          <li>🐰 Bebas Kekejaman Hewan & Vegan</li>
          <li>☁️ Formulasi Seringan Awan</li>
        </ul>
        <a href="/about" class="btn btn-primary mt-4">Pelajari Lebih Lanjut</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 6rem 0;
  }
  
  .section-header {
    margin-bottom: 4rem;
  }
  
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--c-navy);
  }
  
  .section-subtitle {
    color: var(--c-text-light);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .text-center {
    text-align: center;
  }
  
  .mt-4 { margin-top: 2rem; }
  .mb-4 { margin-bottom: 1.5rem; }
  
  /* Hero */
  .hero {
    position: relative;
    padding: 8rem 0 6rem;
    overflow: hidden;
  }
  
  .hero-bg {
    position: absolute;
    top: -10%;
    right: -5%;
    width: 60%;
    height: 120%;
    background: radial-gradient(ellipse at center, rgba(126, 184, 224, 0.2) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    z-index: -1;
    filter: blur(40px);
  }
  
  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: var(--c-sky-light);
    color: var(--c-accent);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .hero .title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--c-navy);
    letter-spacing: -0.02em;
  }
  
  .hero .subtitle {
    font-size: 1.25rem;
    color: var(--c-text-main);
    margin-bottom: 2.5rem;
    max-width: 500px;
    line-height: 1.6;
  }
  
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .hero-image {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transform: rotate(2deg);
    padding: 0.5rem;
  }
  
  .hero-image img {
    border-radius: calc(var(--radius-lg) - 0.5rem);
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  
  /* Featured */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }
  
  /* About */
  .about-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .about-image {
    padding: 0.5rem;
    transform: rotate(-2deg);
  }
  
  .about-image img {
    border-radius: calc(var(--radius-lg) - 0.5rem);
  }
  
  .features-list {
    list-style: none;
    margin: 2rem 0;
  }
  
  .features-list li {
    padding: 0.5rem 0;
    font-weight: 500;
    color: var(--c-navy);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  @media (min-width: 992px) {
    .hero-container, .about-container {
      grid-template-columns: 1fr 1fr;
    }
    
    .hero .title {
      font-size: 4.5rem;
    }
    
    .about-image {
      order: -1;
    }
  }
</style>
