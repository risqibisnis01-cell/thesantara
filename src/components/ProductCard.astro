---
import type { Product } from '../lib/db';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="product-card glass-card">
  <a href={`/product/${product.id}`} class="image-wrapper">
    <img src={product.image} alt={product.name} loading="lazy" />
    <div class="quick-view">Lihat Detail</div>
  </a>
  
  <div class="content">
    <div class="meta">
      <span class="category">{product.categoryId}</span>
      <span class="price">Rp {product.price.toLocaleString('id-ID')}</span>
    </div>
    
    <h3 class="name"><a href={`/product/${product.id}`}>{product.name}</a></h3>
    <p class="desc">{product.description}</p>
    
    <button class="add-to-cart-btn btn btn-primary" data-id={product.id}>
      Tambah ke Keranjang
    </button>
  </div>
</div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }
  
  .image-wrapper {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    display: block;
  }
  
  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  
  .product-card:hover .image-wrapper img {
    transform: scale(1.05);
  }
  
  .quick-view {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 1rem;
    background: linear-gradient(to top, rgba(26, 26, 46, 0.8), transparent);
    color: var(--c-white);
    text-align: center;
    font-weight: 500;
    transform: translateY(100%);
    transition: transform var(--transition-normal);
  }
  
  .image-wrapper:hover .quick-view {
    transform: translateY(0);
  }
  
  .content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }
  
  .category {
    color: var(--c-sky);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  
  .price {
    font-weight: 600;
    color: var(--c-navy);
  }
  
  .name {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  
  .name a {
    color: var(--c-navy);
  }
  
  .name a:hover {
    color: var(--c-accent);
  }
  
  .desc {
    color: var(--c-text-light);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  
  .add-to-cart-btn {
    width: 100%;
    font-size: 0.95rem;
    padding: 0.6rem 1rem;
  }
</style>

<script>
  // Add to cart functionality
  const buttons = document.querySelectorAll('.add-to-cart-btn');
  
  buttons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const productId = target.dataset.id;
      
      const originalText = target.innerText;
      target.innerText = 'Menambahkan...';
      target.disabled = true;
      
      try {
        const res = await fetch('/api/cart', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, quantity: 1 })
        });
        
        if (res.ok) {
          target.innerText = 'Ditambahkan!';
          target.classList.add('success');
          
          // Dispatch event to update cart counter in header
          document.dispatchEvent(new Event('cart-updated'));
          
          setTimeout(() => {
            target.innerText = originalText;
            target.disabled = false;
            target.classList.remove('success');
          }, 2000);
        } else {
          throw new Error('Failed to add');
        }
      } catch (err) {
        target.innerText = 'Gagal';
        setTimeout(() => {
          target.innerText = originalText;
          target.disabled = false;
        }, 2000);
      }
    });
  });
</script>
